        cm = confusion_matrix(PANEL.Y[f"dir_{h}"][r].astype(int), pr[f"dir_{h}"][r].argmax(1), labels=[0, 1, 2], normalize="true")
        a_.imshow(cm, cmap="Greens", vmin=0, vmax=1)
        for i in range(3):
            for j in range(3):
                a_.text(j, i, f"{cm[i, j]:.2f}", ha="center", va="center", fontsize=8)
        a_.set_xticks(range(3)); a_.set_xticklabels(CLASSES, fontsize=7); a_.set_yticks(range(3)); a_.set_yticklabels(CLASSES, fontsize=7)
        a_.set_title(f"Dashboard recipe, {h}-day, test", fontsize=8)
    plt.tight_layout(); savefig(fig, "deploy_confusion_test.png"); plt.show()

# %% [markdown]
### 23.7 Verdicts: hypotheses and the ten project questions

# %%
def fam_summary(df, name):
    if df is None or not len(df):
        return {"family": name, "tests": 0, "supported": 0, "verdict": "Not Run"}
    k = int(df["supported"].sum())
    return {"family": name, "tests": len(df), "supported": k, "verdict": "supported" if k == len(df) else ("partly supported" if k else "not supported")}
HYP = pd.DataFrame([fam_summary(H1, "H1 CV has skill"), fam_summary(H2, "H2 NLP has skill (events)"), fam_summary(H2p, "H2b NLP has skill (panel)"),
                    fam_summary(H3, "H3 fusion beats the better single modality"), fam_summary(H4, "H4 top-3 + top-3 beats top-3 CV"),
                    fam_summary(H5, "H5 fine-tuning beats frozen"), fam_summary(H6, "H6 sector-specific rankings"), fam_summary(H7, "H7 filings move prices")])
HYP.to_csv(SUB["tables"] / "hypotheses_test.csv", index=False); display(HYP)

def _skill_line(df, t):
    if df is None or not len(df) or t not in set(df.task):
        return "Not Run"
    r = df.set_index("task").loc[t]
    return f"{r['model']}: skill {r['skill']:+.3f} [{r['lo']:+.3f}, {r['hi']:+.3f}]{' *' if r['supported'] else ''}"
QANS = []
for h in HORIZONS:
    for kd in ("dir", "vol", "dd"):
        t = f"{kd}_{h}"
        QANS.append({"question": "Q1", "task": t, "CV": _skill_line(H1, t), "NLP (filings)": _skill_line(H2, t), "NLP (panel)": _skill_line(H2p, t),
                     "fusion vs best single": (lambda d: "Not Run" if d is None or not len(d) or t not in set(d.task) else
                                               f"{d.set_index('task').loc[t, 'delta']:+.4f} [{d.set_index('task').loc[t, 'lo']:+.4f}, {d.set_index('task').loc[t, 'hi']:+.4f}]")(H3)})
Q1_ANS = pd.DataFrame(QANS); Q1_ANS.to_csv(SUB["tables"] / "q1_answers_test.csv", index=False)
best_test_cv = CV_RANK_TEST.index[0] if len(CV_RANK_TEST) else None
ANSWERS = {
    "Q1": "See q1_answers_test.csv: '*' marks Holm-significant skill on the locked test block. " +
          f"Direction skill supported for {int(H1[H1.task.str.startswith('dir')]['supported'].sum()) if len(H1) else 0}/4 horizons (CV), "
          f"{int(H2p[H2p.task.str.startswith('dir')]['supported'].sum()) if len(H2p) else 0}/4 (NLP panel); "
          f"fusion beat the better single modality in {int(H3['supported'].sum()) if len(H3) else 0}/{len(H3)} tasks.",
    "Q2": f"Validation-chosen best CV model: {CV_BEST} (validation mean rank {CV_RANK.get(CV_BEST, float('nan')):.2f}); on test it ranks "
          f"{int((CV_RANK_TEST.index == CV_BEST).argmax()) + 1 if CV_BEST in CV_RANK_TEST.index else 'n/a'} of {len(CV_RANK_TEST)}; best on test ex post: {best_test_cv}. " + WHY_CV,
    "Q3": f"Best combination on validation: {BEST_COMBO}; see cv_combos_test.csv for its test standing and all 63 combinations.",
    "Q4": "Best per target and horizon (validation choice and its test score): cv_best_per_target_test.csv.",
    "Q5": "Best model per sector: cv_best_by_sector_test.csv; interaction test (H6) p-values: " + (", ".join(f"{r.target} {r.p:.3f}" for r in H6.itertuples()) if len(H6) else "Not Run"),
    "Q6": "Reaction size by form (test): " + (", ".join(f"{r.group} |z| {r.mean_abs_z:.2f}" for r in ES_FORM_TEST.itertuples()) if len(ES_FORM_TEST) else "Not Run"),
    "Q7": "Sector x form excess reaction over non-filing days: event_study_sector_form_test.csv (development: event_study_sector_form_dev.csv).",
    "Q8": "8-K items ranked by reaction (event_study_8k_items_*.csv), n-grams (nlp_words_*.csv), FinBERT tone (nlp_tone_vs_reaction_dev.csv), attributions (nlp_integrated_gradients_val.csv).",
    "Q9": "Same tables as Q7, read row by row: a sector is 'sensitive' to a form when its excess |z| CI is above zero in both development and test.",
    "Q10": (f"Top-3 CV + top-3 NLP minus top-3 CV: supported in {int(H4['supported'].sum())}/{len(H4)} tasks after Holm." if len(H4) else "Not Run"),
}
NO_CALL = {f"dir_{h}": not bool(SKILL_DEPLOY.set_index("task").loc[f"dir_{h}", "supported"]) if len(SKILL_DEPLOY) and f"dir_{h}" in set(SKILL_DEPLOY.task) else True
           for h in HORIZONS}
FINAL = {"stamp": STAMP, "answers": ANSWERS, "hypotheses": HYP.to_dict("records"), "no_call_direction": NO_CALL,
         "deploy_skill": SKILL_DEPLOY.to_dict("records") if len(SKILL_DEPLOY) else [], "mc_test": MC_TEST.to_dict("records"),
         "test_openings": len(json.loads(VAULT_LOG.read_text())), "freeze_sha": FREEZE["selections_sha256"], "freeze_history": len(FREEZE["freeze_history"])}
(SUB["results"] / "final_results.json").write_text(json.dumps(FINAL, indent=1, default=str))
for k, v in ANSWERS.items():
    display(Markdown(f"**{k}.** {v}"))
tick("23 test")
