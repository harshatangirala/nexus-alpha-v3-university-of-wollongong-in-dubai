### 23B.4 Research design figure, filing timing on the test block, and the hypothesis register (T1)

# %%
try:
    ES_BUCKET_TEST = EV[TE_EV].groupby(["form", "session_bucket"])["abs_z"].agg(["mean", "size"]).round(3).reset_index()
    _save_a3(ES_BUCKET_TEST, "event_study_timing_test.csv", ["form", "session_bucket", "mean", "size"])
except Exception as e_:
