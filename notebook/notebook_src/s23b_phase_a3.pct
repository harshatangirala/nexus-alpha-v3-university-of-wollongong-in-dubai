try:
    fig, ax = plt.subplots(figsize=(13, 3.8)); ax.set_xlim(0, 100); ax.set_ylim(0, 10); ax.axis("off")
    _blocks = [("Training\n2016-10 to 2020-12\n(fit models)", 2, 38, "#cfe2f3"), ("Inner 2021\n(early stopping,\ncalibration)", 41, 13, "#d9ead3"),
               ("Validation 2022-2023\n(every selection)", 57, 18, "#fff2cc"), ("Locked test\n2024-01 to 2026-08\n(opened once)", 78, 20, "#f4cccc")]
    for lab_, x_, w_, c_ in _blocks:
        ax.add_patch(plt.Rectangle((x_, 5.6), w_, 3.2, color=c_, ec="black", lw=0.6)); ax.text(x_ + w_ / 2, 7.2, lab_, ha="center", va="center", fontsize=8)
    for x_ in (40, 55.5, 76.5):
        ax.text(x_, 9.3, "40-session\npurge", ha="center", va="center", fontsize=6.5, color="#990000")
    _flow = ["Verified bars +\nEDGAR filings\n(point in time)", "7 CV + 6 NLP\nmodels, baselines", "Selection on\nvalidation", "Hashed freeze\n(selections,\npredictions)",
             "Vault opened:\nH1-H7 tested", "Post-hoc addenda\n(labelled):\nH1c-H11"]
    for k_, lab_ in enumerate(_flow):
        x_ = 2 + k_ * 16.3
        ax.add_patch(plt.Rectangle((x_, 0.6), 14, 3.6, color="#eeeeee", ec="black", lw=0.6)); ax.text(x_ + 7, 2.4, lab_, ha="center", va="center", fontsize=7.5)
        if k_ < len(_flow) - 1:
            ax.annotate("", xy=(x_ + 16.1, 2.4), xytext=(x_ + 14.2, 2.4), arrowprops=dict(arrowstyle="->", lw=0.8))
    ax.set_title("Research design: time blocks (top) and the order of work (bottom)", fontsize=10)
    plt.tight_layout(); savefig(fig, "research_design.png"); plt.show()
except Exception as e_:
    failed("phase_a3_design_figure", e_)

def _conf(df):
    if df is None or not len(df) or "supported" not in df.columns:
        return 0, "not run"
    return len(df), f"supported in {int(df['supported'].sum())} of {len(df)}"
def _post(df):
    if df is None or not len(df) or "verdict" not in df.columns:
        return 0, "not run"
    vc_ = df["verdict"].value_counts()
    return len(df), f"better {int(vc_.get('better', 0))}, no clear difference {int(vc_.get('no clear difference', 0))}, worse {int(vc_.get('worse', 0))}"
_G = globals().get
REGISTER_SPEC = [
    ("H1", "CV", "confirmatory", "The validation-chosen CV model has skill over the uninformed benchmark (shuffled null, R-squared 0, AUC 0.5)", _conf, "H1"),
    ("H2", "NLP", "confirmatory", "The validation-chosen NLP model has skill on filing events", _conf, "H2"),
    ("H2b", "NLP", "confirmatory", "NLP models carried to the daily panel have skill", _conf, "H2p"),
    ("H3", "CV+NLP", "confirmatory", "Fusion beats the better single modality", _conf, "H3"),
    ("H4", "CV+NLP", "confirmatory", "Top-3 CV + top-3 NLP beats top-3 CV (Q10)", _conf, "H4"),
    ("H5", "CV", "confirmatory", "Fine-tuning beats frozen features", _conf, "H5"),
    ("H6", "CV", "confirmatory", "CV model rankings depend on the sector", _conf, "H6"),
    ("H7", "NLP", "confirmatory", "Filing days move prices more than non-filing days; reactions differ by form", _conf, "H7"),
    ("H1c", "CV", "post-hoc", "Best CV model vs strongest numbers-only baseline", _post, "H1C"),
    ("H1d", "CV", "post-hoc", "Direction skill (own shuffled nulls): best CV vs numbers-only baseline", _post, "H1D"),
    ("H2c", "NLP", "post-hoc", "Best NLP model vs strongest no-text baseline on the same filings", _post, "H2C_EV"),
    ("H2d", "NLP", "post-hoc", "Direction skill (own shuffled nulls): best NLP vs no-text baseline", _post, "H2D"),
    ("H3c", "CV+NLP", "post-hoc", "Best fusion vs strongest numbers-only baseline", _post, "H3C"),
    ("H8", "CV+NLP", "post-hoc", "Technical + CV + NLP features vs technical features (same LightGBM)", _post, "H8"),
    ("H8b", "CV", "post-hoc", "Technical + CV features vs technical features", _post, "H8B"),
    ("H8c", "NLP", "post-hoc", "Technical + NLP features vs technical features", _post, "H8C"),
    ("H8d", "NLP", "post-hoc", "Technical + filing-calendar columns vs technical features", _post, "H8D"),
    ("H8e", "NLP", "post-hoc", "Technical + text vs technical + filing calendar (the words)", _post, "H8E"),
    ("H8f", "NLP", "post-hoc", "Technical + text vs technical + calendar + company (words beyond identity)", _post, "H8F"),
    ("H9a", "CV", "post-hoc", "Best combination of 1-3 CV networks vs best single CV network", _post, "H9A"),
    ("H9b", "NLP", "post-hoc", "Best combination of 1-3 NLP models vs best single NLP model", _post, "H9B"),
    ("H9c", "CV+NLP", "post-hoc", "CV combination + NLP combination vs CV combination", _post, "H9C"),
    ("H9d", "CV+NLP", "post-hoc", "CV combination + NLP combination vs strongest numbers-only baseline", _post, "H9D"),
    ("H10a", "NLP", "post-hoc", "No-text model + text change (Lazy Prices) vs no-text model", _post, "H10A"),
    ("H10b", "NLP", "post-hoc", "No-text model + text change + Loughran-McDonald tone vs no-text model", _post, "H10B"),
    ("H11", "NLP", "post-hoc", "Words explain the size of the reaction beyond form, item, sector and timing (and, in 2 of the tests, the company)", _post, "H11")]
try:
    HYP_REGISTER = pd.DataFrame([{"id": i_, "module": m_, "type": ty_, "statement": s_, "tests": f_(_G(v_))[0], "outcome": f_(_G(v_))[1]}
                                 for i_, m_, ty_, s_, f_, v_ in REGISTER_SPEC])
except Exception as e_:
