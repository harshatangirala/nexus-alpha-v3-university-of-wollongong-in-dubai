def get_secret(name: str):
    """Colab Secrets first, then environment variables. Values are never printed or saved."""
    if os.environ.get(name):
        return os.environ[name]
    if IN_COLAB:
        try:
            from google.colab import userdata
            return userdata.get(name)
        except Exception:
            return None
    return None
