        tbl(rtab("cv_lr_probe.csv"), caption="Learning-rate probe: a short run on a subsample of the training block for two candidate rates per model; the lower inner-block loss is kept"),
        figp("cv_training_curves.png", "Training vs inner-block loss per epoch (early-stopping set).")]),
    ("4. Validation results (selection)", [figp("cv_leaderboard_val.png", "Validation primary metrics; colour = rank within each task."),
        tbl(rtab("cv_rank_val.csv"), caption="Mean validation rank over the 12 tasks (1 = best)"), Pp(mdtext("why_cv_best_val.md")),
        tbl(rtab("cv_skill_val.csv"), ["task", "model", "skill", "lo", "hi", "p", "n"], caption="Validation skill of the best model per task (direction: over the shuffled null; volatility: R-squared; drawdown: AUC minus 0.5)"),
        Pp("Combinations (equal-weight averages of calibrated outputs; nothing fitted):", H2s), tbl(rtab("cv_combo_rank_val.csv"), max_rows=12, caption="Best model combinations by mean validation rank"),
        tbl(rtab("cv_best_per_task_val.csv"), caption="Best model per task on validation"), Pp("Sectors:", H2s), tbl(rtab("cv_best_by_sector_val.csv"), caption="Best CV model per sector and target (validation)"),
        figp("cv_sector_interaction_val.png", "Sector x model interaction (centred metric) and permutation p-values."),
        Pp("Ablations (1,000 bootstrap draws; with this many draws the smallest attainable Holm-corrected p-value is about 0.07 for 36-44 tests, so none can be called significant here):", H2s),
        tbl(rtab("cv_ablations_val.csv"), ["comparison", "A", "target", "delta", "lo", "hi", "p_holm"], max_rows=44, caption="Ablations on validation, 1,000 draws (confirmatory run)"),
        Pp("Post-hoc re-run of the same ablations with 5,000 bootstrap draws; only the precision of the p-values changes:", H2s),
        tbl(rtab("cv_ablations_val_hiB.csv"), ["comparison", "A", "target", "delta", "lo", "hi", "p_holm"], max_rows=44, caption="Ablations on validation, 5,000 draws (post-hoc)"),
        figp("cv_view_ablation.png", "Which timeframe carries the signal (frozen probes).")]),
    ("5. Locked test results (2024-2026)", [
        tbl(rtab("test_H1.csv"), ["task", "model", "skill", "lo", "hi", "p_holm", "supported"], caption="H1 (confirmatory): skill of the validation-chosen CV model over the uninformed benchmark"),
        tbl(rtab("cv_rank_test.csv"), caption="Mean test rank of the fine-tuned CV models"), tbl(rtab("cv_best_per_target_test.csv"), caption="Validation choice, top-3 ensemble and the model that happened to be best on the test, per task"),
        tbl(rtab("cv_combo_rank_test.csv"), max_rows=10, caption="Best model combinations on the locked test"),
        tbl(rtab("test_H5.csv"), ["model", "target", "delta", "lo", "hi", "p_holm", "supported"], caption="H5 (confirmatory, 1,000 draws): fine-tuned minus frozen"),
        tbl(rtab("test_H5_hiB.csv"), ["model", "target", "delta", "lo", "hi", "p_holm", "supported"], caption="H5 re-run with 5,000 draws (post-hoc precision check)"),
        tbl(rtab("cv_best_by_sector_test.csv"), caption="Best CV model per sector and target on the locked test"), tbl(rtab("test_H6.csv"), caption="H6: sector x model interaction (permutation test)")]),
    ("5a. Against the strongest numbers-only baseline (post-hoc)", [
        Pp("The prior is a weak benchmark for volatility and drawdown. For every task the stronger of two numbers-only baselines was chosen on validation: <i>baseline_simple</i> "
           "(momentum for direction, HAR regression for volatility, trailing-volatility logistic model for drawdown) or <i>tech_gbm</i> (LightGBM on 20 technical indicators). "
           "The table gives the best CV model minus that baseline on the locked test."),
        tbl(rtab("phase_a_baseline_choice.csv"), caption="Strongest numbers-only baseline per task (chosen on validation)"),
        tbl(rtab("test_H1c.csv"), ["task", "A", "B", "delta", "lo", "hi", "p_holm", "verdict"], caption="H1c (post-hoc): best CV model minus strongest numbers-only baseline, paired month-block bootstrap, Holm"),
        tbl(rtab("test_H1d.csv"), COLS_D, caption="H1d (post-hoc, the fair direction comparison): skill = macro-F1 minus the model's own within-month shuffled null; delta = CV skill minus baseline skill"),
        tbl(rtab("test_H8b.csv"), ["task", "A", "B", "delta", "lo", "hi", "p_holm", "verdict"], caption="H8b (post-hoc): LightGBM on technical + CV features minus technical features alone"),
        tbl(rtab("phase_a_panel_test.csv"), index=False, max_rows=12, caption="Primary test metric per task for the reference models (post-hoc)")]),
    ("5b. Secondary metrics on the locked test (post-hoc)", secondary_section("cv")),
    ("5c. Combinations of vision networks (post-hoc)", [Pp(combo_text("CV", H9A, "CV network")),
        tbl(_cbs("CV"), ["size", "task", "best_combo", "val_primary", "test_primary"], max_rows=12 * 3, caption="Best combination of each size per task (chosen on validation) and its locked-test primary metric"),
        tbl(rtab("test_H9a.csv"), COLS_V, caption="H9a (post-hoc): best combination of 1-3 CV networks minus the best single CV network, paired month-block bootstrap, Holm")]),
    ("5d. Hypothesis register", [register_table(["CV", "CV+NLP"])]),
    ("6. Error analysis, explainability, robustness, efficiency", [figp("cv_confusion_val.png", "Confusion matrices of the best CV model (validation)."),
        figp("cv_errors_val.png", "Accuracy by volatility decile, sector, quarter and true class."), figp("cv_confident_errors_val.png", "Most confident wrong 20-day calls."),
        figp("cv_gradcam.png", "Grad-CAM: sensitivity maps, not explanations of reasoning; coarse (7x7 / 14x14 cells)."),
        tbl(rtab("cv_occlusion_val.csv"), max_rows=30, caption="Occlusion: metric change when a view or the most recent bars are hidden"),
        tbl(rtab("cv_robustness_val.csv"), max_rows=24, caption="Robustness to noise, blur, JPEG compression, chart style and resizing"), tbl(rtab("cv_efficiency.csv"), caption="Parameters, compute and training time"),
        figp("cv_efficiency.png", "Accuracy vs compute."), figp("yolo_detections.png", "The zero-shot YOLOv8 chart-pattern detector on our weekly charts."),
        tbl(rtab("yolo_patterns_train.csv"), caption="Chart patterns detected by the zero-shot detector (training block)")]),
    ("7. Discussion", cv_discussion()),
    ("8. Threats to validity and limitations", [Pp("<b>Population.</b> Fifty large, surviving US stocks (survivorship bias); the original image-prediction literature found most signal in small caps. "
        "<b>Time.</b> One decade with a 2022 bear market in validation and a strong 2024-2026 market in test (regime shift); the sideways band is volatility-scaled, which makes direction hard by design. "
        "<b>Inputs.</b> Prices are not dividend-adjusted; charts are rebuilt from bars, so the models never saw real broker screenshots (the dashboard redraws them); each chart is min-max scaled, which "
        "hides absolute volatility. <b>Training.</b> One seed per model, two-value learning-rate grids and short early-stopped training; the differences between close models are within seed noise. "
        "<b>Inference.</b> Validation was used for many choices, so only the locked test numbers are unbiased; the post-hoc comparisons in section 5a were added after the test was opened and "
        "should be read as exploratory. <b>Explanations.</b> Grad-CAM and occlusion show sensitivity, not causation."), future_work("cv")]),
    ("8a. Ethics and data governance", ethics_items("cv")),
    ("9. Conclusion", cv_conclusion()),
    ("References", refs(["jkx", "he_resnet", "tan", "liu_convnext", "dosovitskiy", "liu_swin", "redmon", "jocher", "sezer", "ho", "corsi", "patton",
                         "guo", "selvaraju", "hendrycks", "kunsch", "holm"])),
]

# %%
# ================================================================ Report 2: NLP
_nlp_ran = [NLPC[e]["label"] for e in NLPC if any(REG.get(m, {}).get("status") == "RUN" for m in (f"{e}_ft", f"{e}_frozen"))]
_fg = "" if REG.get("fingpt_frozen", {}).get("status") == "RUN" else " FinGPT was not run: access to Meta's gated Llama-2 base model was not granted before the deadline."
def _dir_count_text():
    if not _ok(H2, "task", "supported"):
        return ""
    return f"direction {len(sig_tasks(H2, 'dir'))}/4, volatility {len(sig_tasks(H2, 'vol'))}/4, drawdown {len(sig_tasks(H2, 'dd'))}/4"
_ef0 = _event_facts()
nlp_event_lead = (f"Which SEC filings move prices? In a point-in-time event study on {len(TICKERS)} companies" +
                  (f", filing days move prices {_ef0['ratio']:.1f} times as much as matched non-filing days on the locked test" if "ratio" in _ef0 else "") +
                  (f"; by reaction size the forms rank {_ef0['rank']}" if "rank" in _ef0 else "") +
                  (f"; the 8-K items with the largest reactions are {_ef0['items']} (development blocks)" if "items" in _ef0 else "") + ". " + hyp_line(H7, "H7 (event study)") + " ")
nlp_abs = nlp_event_lead + (f"Can language models forecast the move? {len(_nlp_ran)} language models ({', '.join(_nlp_ran)}) and a TF-IDF baseline read the MD&A of "
           f"10-K and 10-Q reports and the text of 8-K filings of {len(TICKERS)} companies (point-in-time EDGAR timestamps) and forecast direction, "
           f"volatility and a >10 % drawdown from the first tradeable price after each filing. Validation-chosen best: {NLP_BEST}. " +
           hyp_line(H2, "H2 (NLP skill on filing events)") + f" Tasks with supported skill: {_dir_count_text()}." +
           f" Post-hoc, against the strongest no-text baseline on the same filings (per-company base rates, momentum/HAR/trailing volatility + form, or LightGBM on indicators + form, chosen on validation) "
           f"the best NLP model per task is {vphrase(H2C_EV)}; for drawdown it is {vphrase(H2C_EV, 'dd')}. " + shortcut_text(short=True) + " "
           "The test period starts after the pre-training cut-off of every language model, so no model can remember test-period news." + _fg)

def nlp_training_text():
    return Pp("Frozen: chunked (4 x 512 tokens; Longformer 4,096) mean-pooled embeddings, 32 principal components, "
              "regularised linear heads. Fine-tuned: the same multi-task head as the CV models, AdamW, learning rate from a two-value probe, early stopping on "
              "2021 filings (up to 3 epochs). FinGPT: Llama-2-7B + FinGPT LoRA in 4-bit, frozen embeddings plus its own sentiment read-out. " + best_epoch_text(NLP_MAIN))

def _top_sector_text(df, tag):
    if not _ok(df, "sector", "form", "excess_over_non_filing_days"):
        return ""
    parts = []
    for f_, g in df.groupby("form"):
        hi_, lo_ = g.loc[g["excess_over_non_filing_days"].idxmax()], g.loc[g["excess_over_non_filing_days"].idxmin()]
        parts.append(f"{f_}: highest {hi_['sector']} ({hi_['excess_over_non_filing_days']:+.2f}), lowest {lo_['sector']} ({lo_['excess_over_non_filing_days']:+.2f})")
    return f"{tag}: " + "; ".join(parts) + "."

def nlp_discussion():
    out = []
    es = rtab("event_study_by_form_test.csv"); h7 = rtab("test_H7.csv")
    if _ok(es, "group", "mean_abs_z"):
        out.append(Pp("<b>Which report moves the market (Q6).</b> Mean absolute abnormal two-day move on the locked test, in normal-day units: " +
                      ", ".join(f"{r.group} {r.mean_abs_z:.2f} (n={int(r.n)})" for r in es.itertuples()) + ". " +
                      ("Filing days move more than matched non-filing days (Mann-Whitney p " + ("<0.001" if float(h7['p'].iloc[0]) < 0.001 else f"= {float(h7['p'].iloc[0]):.3f}") +
                       ") and the forms differ (Kruskal-Wallis p " + ("<0.001" if float(h7['p'].iloc[1]) < 0.001 else f"= {float(h7['p'].iloc[1]):.3f}") + ")." if _ok(h7, "p") and len(h7) > 1 else "")))
    out.append(Pp("<b>Which sectors (Q7, Q9).</b> " + _top_sector_text(rtab("event_study_sector_form_dev.csv"), "Development") + " " + _top_sector_text(rtab("event_study_sector_form_test.csv"), "Test") +
                  " A sector is called more sensitive to a form when its excess reaction (mean |z| minus the same sector's non-filing days) is larger; agreement between the two periods is the evidence that the pattern is stable."))
    it = rtab("event_study_8k_items_dev.csv"); wd = rtab("nlp_words_abs_z_dev.csv"); tn = rtab("nlp_tone_vs_reaction_dev.csv")
    q8 = "<b>What in the reports (Q8).</b> "
    if _ok(it, "item", "mean_abs_z"):
        q8 += "8-K items with the largest reactions: " + ", ".join(f"{r.item} ({r.mean_abs_z:.2f})" for r in it.head(3).itertuples()) + ". "
    if _ok(wd, "top_positive"):
        q8 += "Phrases most associated with large reactions: " + ", ".join(str(x) for x in wd["top_positive"].head(6)) + "; most associated with small reactions: " + ", ".join(str(x) for x in wd["top_negative"].head(6)) + ". "
    if _ok(tn, "form", "spearman_tone_vs_signed_AR"):
        r_all = tn[tn["form"] == "all"]
        if len(r_all):
            q8 += f"FinBERT sentence tone is almost unrelated to the sign of the reaction (Spearman {float(r_all['spearman_tone_vs_signed_AR'].iloc[0]):+.3f}) and weakly related to its size ({float(r_all['spearman_tone_vs_abs_z'].iloc[0]):+.3f}). "
    q8 += "Phrases that mark the filing type, the period (for example pandemic-era wording) or a company name are associations with the form, the time or the firm rather than with news; read the table with that in mind."
    out.append(Pp(q8))
    sd, sv, sk = sig_tasks(H2, "dir"), sig_tasks(H2, "vol"), sig_tasks(H2, "dd")
    n_neg = int((H2[H2["task"].astype(str).str.startswith("vol")]["skill"] < 0).sum()) if _ok(H2, "task", "skill") else 0
    out.append(Pp(f"<b>Can language models forecast from filings?</b> Against the uninformed benchmarks the validation-chosen NLP models have skill in {len(sd)} of 4 direction, {len(sv)} of 4 volatility and "
                  f"{len(sk)} of 4 drawdown tasks on the locked test. For volatility the skill is negative (worse than predicting the training mean) in {n_neg} of 4 tasks"
                  + (", which means that text alone does not track volatility regimes." if n_neg >= 2 else ".")))
    out.append(Pp(f"<b>Is the drawdown signal only company identity? (post-hoc)</b> A filing tells the model which company wrote it, and a company's usual volatility predicts its drawdown risk. "
                  f"Against the strongest no-text baseline on the same filings the best NLP model is {vphrase(H2C_EV, 'dd')} for drawdown, {vphrase(H2C_EV, 'vol')} for volatility and "
                  f"{vphrase(H2C_EV, 'dir')} for direction. A drawdown gain over the prior that disappears against the per-company or numbers-only baseline would indicate that the text mostly identifies the company; "
                  f"a gain that survives indicates information beyond identity. Judged fairly on direction (each model against its own shuffled null, H2d), the best NLP model is {vphrase(H2D)}."))
    out.append(Pp("<b>Does text add to simple numbers on the daily panel? (post-hoc)</b> Technical + text features versus technical alone (H8c) is "
                  f"{vphrase(H8C)}. " + text_vs_calendar_text()))
    out.append(Pp("<b>Fine-tuned versus frozen, length and domain.</b> The 5,000-draw ablation table shows, per comparison, the mean difference on each target; "
                  "reading chunked versus first-512-token inputs and fine-tuned versus frozen encoders there is more reliable than in the 1,000-draw table, whose smallest attainable "
                  "Holm-corrected p-value (about 0.07) is above the 5 % level. " + best_epoch_text(NLP_MAIN)))
    for s_ in (nlp_stability_text(), shortcut_text()):
        if s_:
            out.append(Pp(s_))
    return out
def nlp_conclusion():
    es = rtab("event_study_by_form_test.csv"); ratio_txt = ""
    if _ok(es, "group", "mean_abs_z"):
        ctrl = es[es["group"].astype(str).str.startswith("no filing")]["mean_abs_z"]
        fil = es[~es["group"].astype(str).str.startswith("no filing")]["mean_abs_z"]
        if len(ctrl) and len(fil) and float(ctrl.iloc[0]) > 0:
            _rk = _event_facts().get("rank")
            ratio_txt = (f"The clearest NLP result is the event study: on the locked test, filing days move prices {float(fil.mean()) / float(ctrl.iloc[0]):.1f} times as much as matched non-filing days"
                         + (f", the forms rank {_rk} by reaction size" if _rk else "") + ", and the reaction differs by sector. ")
    bd = vcounts(H2C_EV, "dd")
    interp = ""
    if bd:
        if bd[0] == 0:
            interp = "The drawdown gain over the prior does not survive against the strongest no-text baseline, so it should not be read as information in the text beyond the company and simple numbers."
        elif bd[0] == bd[3]:
            interp = "The drawdown gain over the prior survives against the strongest no-text baseline in every task, which indicates information in the text beyond the company and simple numbers."
        else:
            interp = "The drawdown gain over the prior survives against the strongest no-text baseline in some tasks only."
    return [Pp(f"{ratio_txt}Language-model forecasts of direction are supported in {len(sig_tasks(H2, 'dir'))} of 4 horizons, of volatility in {len(sig_tasks(H2, 'vol'))} of 4 and of drawdown risk in "
               f"{len(sig_tasks(H2, 'dd'))} of 4 tasks over the uninformed benchmarks. Against the strongest no-text baseline the best NLP model is {vphrase(H2C_EV)} (drawdown: {vphrase(H2C_EV, 'dd')}). "
               f"{interp} {text_vs_calendar_text()} {shortcut_text(short=True)} {h11_short()} Combining language models: the best combination versus the best single model is {vphrase(H9B)}. Comparisons between fine-tuned transformers and the TF-IDF baseline should be read with the confidence intervals, not the ranks.")]

