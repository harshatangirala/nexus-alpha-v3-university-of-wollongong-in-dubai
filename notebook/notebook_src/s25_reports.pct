                 ". Replacements versus the brief (no verified 10-year hourly bars): " + ", ".join(f"{a}->{b}" for a, b in REPLACED.items()) + ".")
def common_front(kind):
    return [Pp(f"Master of Applied Artificial Intelligence, University of Wollongong in Dubai. {RUN_LINE}"),
            Pp("<b>Educational research; not financial advice. Every result is an out-of-sample predictive association, not a cause.</b>"),
            Pp("Data", H2s), Pp(f"Universe ({len(TICKERS)} stocks): {UNIVERSE_LINE}"),
            Pp(f"Prices: TriFrame tier-A verified bars (SHA-256 manifest {DATA_MANIFEST_SHA256[:12]}), split-adjusted, not dividend-adjusted; "
               "1-week, 1-day and regular-hours 1-hour bars; data end 2026-10-09. Decisions 2016-10-10 onward; blocks: train 2016-10 to 2020-12, "
               "inner 2021 (early stopping and calibration), validation 2022-2023 (all selection), locked test 2024-01 to 2026-08 (opened after "
               "the freeze; every opening is logged). 40-session purge between blocks. Targets at 5/10/20/40 sessions: 3-class direction with a "
               "0.5 sigma sqrt(h) band, log realised volatility from hourly bars, and a >10 % drawdown."),
            Pp("<b>Confirmatory and post-hoc results.</b> The hypotheses H1-H7 and every selection were fixed and frozen before the test block was opened. After the "
               "test a methodological review asked for stronger baselines (numbers-only models instead of only the prior), a test of whether charts and text add "
               "information to technical indicators (H8), and more precise p-values for the many-test ablations. These additions are labelled <i>post-hoc</i> "
               "wherever they appear; they use the same locked test rows, only models trained on the training block and tuned on 2021, and baselines chosen on "
               "validation. They do not replace the confirmatory results."),
            tbl(rtab("leakage_tests.csv"), caption="Leakage tests (all must pass)")]
def build_pdf(path, title, sections):
    REQUIRED_MISSING.clear()
    story_body = []
    for heading, items in (sections() if callable(sections) else sections):
        story_body.append(Pp(heading, H1s)); story_body += items
    full_title = ("INCOMPLETE DRAFT: " if REQUIRED_MISSING else "") + title
    story = [Pp(full_title, TITLE)]
    if QUICK:
        story.append(Pp("<b>QUICK_VERIFY - NOT RESEARCH RESULTS.</b> Reduced run (10 stocks, short training) that checks the pipeline. Do not cite any number."))
    if REQUIRED_MISSING:
        story.append(Pp("Missing artifacts: " + ", ".join(sorted(set(REQUIRED_MISSING))), CAP))
    story += story_body
    doc = SimpleDocTemplate(str(path), pagesize=A4, leftMargin=2 * cm, rightMargin=2 * cm, topMargin=1.8 * cm, bottomMargin=1.8 * cm, title=full_title)
    def on_page(c_, d_):
        c_.saveState(); c_.setFont(FONT, 7); c_.drawString(2 * cm, 1.1 * cm, f"{title} | {STAMP} | page {d_.page}"); c_.restoreState()
    doc.build(story, onFirstPage=on_page, onLaterPages=on_page)
    return path

def hyp_line(df, label):
    if df is None or not len(df):
        return f"{label}: Not Run."
    return f"{label}: {int(df['supported'].sum())} of {len(df)} Holm-corrected tests supported on the locked test block."

# ---------------------------------------------------------------- data-driven text helpers (every number below is read from a table)
H1C, H2C_EV, H2C_PANEL, H3C, H8, H8B, H8C = (globals().get(n_) for n_ in ("H1C", "H2C_EV", "H2C_PANEL", "H3C", "H8", "H8B", "H8C"))
H5_HI, MC_TEST_SCALED = globals().get("H5_HI"), globals().get("MC_TEST_SCALED")
H8D, H8E, H8F, H1D, H2D = (globals().get(n_) for n_ in ("H8D", "H8E", "H8F", "H1D", "H2D"))
COLS_D = ["task", "A", "B", "skill_A", "skill_B", "delta", "lo", "hi", "p_holm", "verdict"]
COLS_V = ["task", "A", "B", "delta", "lo", "hi", "p_holm", "verdict"]
TNAME = {"dir": "direction", "vol": "volatility", "dd": "drawdown"}
def _ok(df, *cols):
    return df is not None and len(df) > 0 and all(c in df.columns for c in cols)
def vcounts(df, prefix=None):
    if not _ok(df, "task", "verdict"):
        return None
    d = df if prefix is None else df[df["task"].astype(str).str.startswith(prefix)]
    vc = d["verdict"].value_counts()
    return int(vc.get("better", 0)), int(vc.get("no clear difference", 0)), int(vc.get("worse", 0)), len(d)
def vphrase(df, prefix=None):
    c = vcounts(df, prefix)
    if c is None:
        return "not run"
    return f"better in {c[0]} of {c[3]} tasks, no clear difference in {c[1]}, worse in {c[2]}"
def sig_tasks(df, prefix):
    if not _ok(df, "task", "supported"):
        return []
    return [str(t) for t, s in zip(df["task"], df["supported"]) if str(t).startswith(prefix) and bool(s)]
def mean_of(df, col, prefix):
    if not _ok(df, "task", col):
        return float("nan")
    return float(df[df["task"].astype(str).str.startswith(prefix)][col].mean())
def best_epoch_text(models):
    cur = rtab("cv_training_curves.csv") if models is CV_MAIN else rtab("nlp_training_curves.csv")
    if not _ok(cur, "model", "epoch", "inner_loss"):
        return ""
    cur = cur[cur["model"].isin(models)]
    if not len(cur):
        return ""
    best = cur.loc[cur.groupby("model")["inner_loss"].idxmin()]
    n1, nm = int((best["epoch"] == 1).sum()), best["model"].nunique()
    return (f"For {n1} of {nm} fine-tuned networks the lowest loss on the early-stopping block (2021) was reached after the first epoch, so the checkpoint kept by early "
            f"stopping is the one from epoch 1 and later epochs only fitted the training block better. Short, early-stopped fine-tuning is therefore the regime these results describe.")
def text_vs_calendar_text():
    """Data-driven reading of H8c-H8f for volatility: is the text gain content, calendar or company identity?"""
    c, d, e, f = vcounts(H8C, "vol"), vcounts(H8D, "vol"), vcounts(H8E, "vol"), vcounts(H8F, "vol")
    if not (c and d and e and f):
        return "The calendar and company controls were not run."
    s = (f"For volatility, adding the filing-calendar columns alone to the technical model is {vphrase(H8D, 'vol')}; adding the text on top of the calendar (H8e) is "
         f"{vphrase(H8E, 'vol')}; adding the text on top of the calendar and the company identity (H8f) is {vphrase(H8F, 'vol')}. ")
    mC, mD, mE, mF = (mean_of(x, "delta", "vol") for x in (H8C, H8D, H8E, H8F))
    s += (f"Mean gain in R-squared over the four volatility horizons: technical + text versus technical {mC:+.3f}; calendar alone {mD:+.3f}; "
          f"text beyond the calendar {mE:+.3f}; text beyond the calendar and the company {mF:+.3f}. ")
    if f[0] > f[3] / 2:
        s += "So the text carries volatility information beyond knowing when filings happen and which company filed them."
    elif d[0] > d[3] / 2 and (e[0] > 0 or f[0] > 0):
        s += (f"So most of the volatility gain comes from the filing calendar (proximity to earnings filings); the words add a smaller but statistically supported amount "
              f"in {e[0]} of {e[3]} horizons beyond the calendar and in {f[0]} of {f[3]} beyond the calendar and the company.")
    elif e[0] > e[3] / 2:
        s += "So the text adds volatility information beyond the filing calendar, but most of it is explained once the company is known: the embeddings largely identify the firm."
    elif d[0] > d[3] / 2:
        s += "So the volatility gain is explained by the filing calendar (proximity to earnings filings); no supported gain from the words remains."
    else:
        s += "The evidence on where the gain comes from is mixed; it should not be attributed to the content of the text."
    return s
def abl_delta(df, comparison, target):
    if not _ok(df, "comparison", "target", "delta"):
        return None
    r = df[(df["comparison"] == comparison) & (df["target"] == target)]
    return float(r["delta"].iloc[0]) if len(r) else None

# ---------------------------------------------------------------- Phase A2d: secondary metrics, contributions, training stability, shortcut learning
def _sec(nm, kd):
    return rtab(f"secondary_{nm}_{kd}_test.csv")
def accuracy_text(nm):
    """Plain accuracy, balanced accuracy and log loss of the validation-chosen model versus the uninformed prior (direction)."""
    d = _sec(nm, "dir")
    if not _ok(d, "role", "task", "accuracy", "balanced_acc", "log_loss"):
        return ""
    pr = d[d["role"] == "uninformed prior"].set_index("task"); bm = d[d["role"].astype(str).str.startswith("best")].set_index("task")
    ts = [t for t in TASKS if t in bm.index and t in pr.index]
    if not ts:
        return ""
    n_acc = sum(float(bm.loc[t, "accuracy"]) > float(pr.loc[t, "accuracy"]) for t in ts)
    d_bal = float(np.mean([float(bm.loc[t, "balanced_acc"]) - float(pr.loc[t, "balanced_acc"]) for t in ts]))
    d_ll = float(np.mean([float(bm.loc[t, "log_loss"]) - float(pr.loc[t, "log_loss"]) for t in ts]))
    return (f"<b>Accuracy.</b> The plain accuracy of the validation-chosen model is above that of always predicting the most common class in {n_acc} of {len(ts)} direction tasks "
            f"(for example {ts[0]}: {float(bm.loc[ts[0], 'accuracy']):.3f} versus {float(pr.loc[ts[0], 'accuracy']):.3f}); its balanced accuracy is higher by {d_bal:+.3f} on average "
            f"and its log loss differs by {d_ll:+.3f} (lower is better). Accuracy rewards a model that always predicts the majority class, which is why macro-F1 and skill over a "
            f"shuffled null are the primary direction metrics: any edge lies in finding UP and DOWN moves, not in being right more often overall.")
def brier_text(nm):
    """Ranking (ROC-AUC) versus probability level (Brier skill) for drawdown."""
    d = _sec(nm, "dd")
    if not _ok(d, "role", "task", "auc", "bss"):
        return ""
    bm = d[d["role"].astype(str).str.startswith("best")]
    if not len(bm):
        return ""
    n_pos = int((bm["bss"] > 0).sum())
    return (f"<b>Drawdown probabilities.</b> The validation-chosen model has ROC-AUC {bm['auc'].min():.2f} to {bm['auc'].max():.2f}, but a positive Brier skill score (probabilities "
            f"closer to the outcomes than a constant forecast at the training-block base rate) in {n_pos} of {len(bm)} tasks (range {bm['bss'].min():+.3f} to {bm['bss'].max():+.3f}). "
            + ("It ranks drawdown risk better than it sets the probability level, which drifts when the base rate moves between periods." if n_pos < len(bm) / 2 else
               "Its probabilities are mostly better than a constant base-rate forecast."))
def secondary_section(nm):
    return [Pp("The primary metrics above are complemented here by accuracy, balanced accuracy, log loss and per-class F1 (direction), QLIKE, Spearman and MAE (volatility), and PR-AUC, "
               "Brier skill and calibration error (drawdown), for the same models on the same locked-test rows. Post-hoc: these metrics were computed in the confirmatory run's code "
               "but not reported; nothing was selected on them."),
            Pp(accuracy_text(nm)), Pp(brier_text(nm)),
            tbl(_sec(nm, "dir"), max_rows=24, caption="Direction: macro-F1, accuracy, balanced accuracy, log loss and F1 per class on the locked test"),
            tbl(_sec(nm, "vol"), max_rows=24, caption="Volatility: R-squared, QLIKE (lower is better), Spearman correlation and mean absolute error on the locked test"),
            tbl(_sec(nm, "dd"), max_rows=24, caption="Drawdown: ROC-AUC, PR-AUC, Brier skill score (vs a constant forecast at the training base rate), calibration error (ECE) and base rate on the locked test")]
def shuffle_control_text():
    d = _sec("cv", "dir")
    if not _ok(d, "role", "task", "macro_f1"):
        return ""
    g = d.pivot_table(index="task", columns="role", values="macro_f1", aggfunc="first")
    need = ["label-shuffle control", "numbers-only baseline", "best CV model (validation)"]
    if not all(c in g.columns for c in need):
        return ""
    g = g.dropna(subset=need)
    n_beat = int((g[need[0]] > g[need[1]]).sum()); gap = float((g[need[2]] - g[need[0]]).mean())
    return (f"<b>Why raw macro-F1 comparisons are inflated.</b> A ResNet-50 probe fitted on shuffled training labels, which carry no information about the future, scores a higher "
            f"macro-F1 than the numbers-only baseline in {n_beat} of {len(g)} direction tasks, because the baselines predict mostly one class and macro-F1 punishes that. "
            f"The validation-chosen CV model is {gap:+.3f} macro-F1 above this control on average; that gap and the H1d comparison, not the raw difference to the baselines, "
            f"measure what the charts add.")
def cv_contributions():
    ds = sig_tasks(H1, "dir"); bd = vcounts(H1D)
    items = ["A controlled benchmark of seven vision architectures (from-scratch CNN, ResNet-50, EfficientNet-B0, ConvNeXt-T, ViT-B/16, Swin-T, YOLOv8s-cls) on identical, "
             "leakage-controlled rows: weekly, daily and hourly charts stacked as one input, four horizons, three targets, and a test block opened only after a hashed freeze.",
             (f"A small, short-horizon direction signal in charts: supported over a shuffled null in {len(ds)} of 4 horizons ({', '.join(ds)})" if ds else
              "No direction signal supported over a shuffled null") + (f"; judged fairly against the numbers-only baselines (H1d) the best CV model is better in {bd[0]} of {bd[3]} tasks." if bd else "."),
             f"A negative result for risk: against simple numbers the charts are {vphrase(H1C, 'vol')} on volatility and {vphrase(H1C, 'dd')} on drawdown, with a candidate design "
             f"explanation (per-chart price scaling removes the absolute volatility level; section 7).",
             "A methodological check: raw macro-F1 comparisons against baselines that predict mostly one class are inflated; a label-shuffle control and own-null skill (H1d) correct for it (section 7).",
             "Deployment evidence: robustness to screenshot corruptions, compute cost per model, and a dashboard recipe parity-tested against the notebook."]
    return [Pp("<b>Contributions.</b>")] + [Pp(f"{i}. {s}") for i, s in enumerate(items, 1)]
def _event_facts():
    es, out = rtab("event_study_by_form_test.csv"), {}
    if _ok(es, "group", "mean_abs_z"):
        ctrl = es[es["group"].astype(str).str.startswith("no filing")]["mean_abs_z"]
        fil = es[~es["group"].astype(str).str.startswith("no filing")]
        if len(ctrl) and len(fil) and float(ctrl.iloc[0]) > 0:
            out["ratio"] = float(fil["mean_abs_z"].mean()) / float(ctrl.iloc[0])
        if len(fil):
            out["rank"] = " > ".join(str(g_) for g_ in fil.sort_values("mean_abs_z", ascending=False)["group"])
    it = rtab("event_study_8k_items_dev.csv")
    if _ok(it, "item", "mean_abs_z"):
        out["items"] = ", ".join(f"{r.item} ({r.mean_abs_z:.2f})" for r in it.head(2).itertuples())
    return out
def nlp_stability_text():
    cur = rtab("nlp_training_curves.csv")
    if not _ok(cur, "model", "epoch", "inner_loss"):
        return ""
    cur = cur[cur["model"].isin(NLP_MAIN)]
    if not len(cur):
        return ""
    best = cur.groupby("model")["inner_loss"].min(); med = float(best.median())
    bad = best[best > 1.2 * med]
    n_tr = int(np.asarray(EVENT.mask["train"]).sum())
    s = (f"<b>Training stability, and why TF-IDF ranks first on validation.</b> The fine-tuned encoders were trained on {n_tr:,} training-block filings. Their best early-stopping loss "
         f"ranges from {best.min():.2f} to {best.max():.2f} (median {med:.2f}). ")
    if len(bad):
        rising = [m for m in bad.index if len(cur[cur["model"] == m]) > 1 and float(cur[cur["model"] == m].sort_values("epoch")["inner_loss"].iloc[-1]) > float(bad[m])]
        s += ("; ".join(f"{LABEL_OF.get(m, m)} reached only {float(v):.2f}" for m, v in bad.items()) + ", well above the other encoders"
              + (", and its loss rose again in the next epoch" if rising else "") + ": fine-tuning " + ("that model" if len(bad) == 1 else "those models")
              + " was unstable at this data size, so the fine-tuned scores understate the architecture and the frozen features are the fairer reading. "
              "Instability of large-encoder fine-tuning on small data sets is a documented phenomenon (Dodge et al. 2020; Mosbach et al. 2021), usually addressed with several seeds, "
              "longer warm-up and layer-wise learning rates, which the pre-registered v3.1 protocol adopts. ")
    if NLP_BEST and str(NLP_BEST).startswith("tfidf"):
        s += ("With this few labelled filings, a regularised linear model on TF-IDF n-grams, which has far fewer effective parameters, has the best mean validation rank. "
              "This is consistent with large encoders over-fitting small, noisy financial labels, and it is why the comparison is read through confidence intervals rather than ranks.")
    return s
def shortcut_text(short=False):
    bd = vcounts(H2C_EV, "dd")
    if not bd:
        return ""
    mC, mD, mE = mean_of(H8C, "delta", "vol"), mean_of(H8D, "delta", "vol"), mean_of(H8E, "delta", "vol")
    cal_ok = np.isfinite(mD) and np.isfinite(mE)
    shortcut = bd[0] == 0 and (not cal_ok or mD > mE)
    if short:
        return ("Most of the forecasting signal the language models find is who filed and when, not what the filing says." if shortcut else
                "Part of the forecasting signal the language models find is who filed and when.")
    parts = [f"against no-text baselines on the same filings the best NLP model is {vphrase(H2C_EV, 'dd')} for drawdown"]
    if cal_ok:
        parts.append(f"on the daily panel the filing-calendar columns alone add {mD:+.3f} R-squared for volatility, while the words add {mE:+.3f} beyond the calendar "
                     f"(all text features together: {mC:+.3f})")
    parts.append("the integrated-gradients tokens of the largest-reaction filings (section 6) include many dates, company names and formatting tokens")
    s = "<b>Shortcut learning (post-hoc).</b> The evidence points the same way: " + "; ".join(parts) + ". "
    s += ("The forecasting signal the language models find is therefore mostly who filed and when, not what the filing says: a case of shortcut learning, where a network exploits "
          "an easy correlate of the label instead of the intended content (Geirhos et al. 2020). This is a negative result about text content, obtained with controls (per-company base rates, "
          "numbers-only baselines, filing-calendar columns) that many filing-text studies omit; it complements reports of return predictability from language-model scores of news "
          "(Lopez-Lira and Tang 2023), which concern headlines rather than periodic filings, by showing how much of a filing-based signal survives such controls." if shortcut else
          "Part of the signal is who filed and when; only what survives these controls can be attributed to the content of the text.")
    return s
def nlp_contributions():
    ef = _event_facts()
    ev = ("A point-in-time event study (EDGAR acceptance time + 35 minutes, matched non-filing days as controls)"
          + (f": filing days move prices {ef['ratio']:.1f} times as much as non-filing days on the locked test" if "ratio" in ef else "")
          + (f", the forms rank {ef['rank']} by reaction size" if "rank" in ef else "")
          + (f", the 8-K items with the largest reactions are {ef['items']}" if "items" in ef else "")
          + ", and sector rankings are compared between development and test (" + hyp_line(H7, "H7").rstrip(".") + ").")
    items = [ev,
             f"A controlled comparison of {len(_nlp_ran)} language models spanning domain pre-training, size, long context and a 7-billion-parameter LLM, against TF-IDF, on identical "
             "filings, with a test period after every model's pre-training cut-off (no look-ahead memory).",
             "A shortcut-learning check: per-company base rates, numbers-only baselines and filing-calendar columns separate what the text says from who filed and when (sections 5a and 8). "
             + shortcut_text(short=True),
             "Theory-driven, interpretable text measures (the change in a filing's wording, Loughran-McDonald tone) and a reaction-size regression that separates the words from the "
             "kind and timing of the filing (sections 5d and 5e).",
             "Diagnostics for small-sample fine-tuning: training curves, unstable encoders and the TF-IDF result are reported rather than hidden (section 8)."]
    return [Pp("<b>Contributions.</b>")] + [Pp(f"{i}. {s}") for i, s in enumerate(items, 1)]
def deploy_dd_text():
    lb = rtab("fusion_leaderboard_test.csv")
    base = "presents probabilities calibrated on 2021 and a simulation range"
    if not _ok(lb, "model", "target", "auc", "bss"):
        return base
    d = lb[(lb["model"] == "deploy_recipe") & (lb["target"] == "dd")]
    if not len(d):
        return base
    if (d["bss"] <= 0).all():
        return (base + f"; on the test its drawdown probabilities rank risk (ROC-AUC {d['auc'].min():.2f} to {d['auc'].max():.2f}) but their level is no better than a constant forecast "
                f"at the training base rate (Brier skill {d['bss'].min():+.3f} to {d['bss'].max():+.3f}), so they are read as relative risk")
    return base + f"; its drawdown probabilities beat a constant forecast at the training base rate in {int((d['bss'] > 0).sum())} of {len(d)} horizons"

# ---------------------------------------------------------------- Phase A3: combinations, interpretable text features, ethics, register, v3.1 protocol
H9A, H9B, H9C, H9D, H10A, H10B, H11 = (globals().get(n_) for n_ in ("H9A", "H9B", "H9C", "H9D", "H10A", "H10B", "H11"))
def combo_text(modality, hdf, single_label):
    sel = rtab("combo_selection.csv")
    if not _ok(sel, "modality", "size"):
        return "The combination study was not run."
    s_ = sel[sel["modality"] == modality]
    if not len(s_):
        return "The combination study was not run for this modality."
    sz = s_["size"].astype(int).value_counts()
    s = (f"<b>Combinations of networks (post-hoc).</b> Every single model, pair and triple was averaged with equal weights (63 candidates) and re-calibrated on 2021 like every other ensemble; "
         f"the best was chosen per task on validation: a single network in {int(sz.get(1, 0))}, a pair in {int(sz.get(2, 0))} and a triple in {int(sz.get(3, 0))} of {len(s_)} tasks. "
         f"Against the best single {single_label} on the locked test the chosen combination is {vphrase(hdf)} (direction: {vphrase(hdf, 'dir')}; volatility: {vphrase(hdf, 'vol')}; drawdown: {vphrase(hdf, 'dd')}). ")
    multi = set(s_.loc[s_["size"].astype(int) > 1, "task"])
    if _ok(hdf, "task", "verdict") and int(sz.get(1, 0)) > 0:
        hm = hdf[hdf["task"].isin(multi)]
        s += (f"Where validation chose a single network ({int(sz.get(1, 0))} tasks) the combination is that network, so the difference is zero by construction; "
              f"where it chose a pair or triple ({len(multi)} tasks) the combination is " + (vphrase(hm) if len(hm) else "not testable") + ". ")
    nb = (vcounts(hdf) or (0, 0, 0, 0))[0]
    s += ("Combining networks is therefore not worth it in this modality." if nb == 0 else
          "Combining networks helps in some tasks; the gain is measured against the best single network of the same modality, not against the numbers-only baselines.")
    return s
def grid_text():
    g = rtab("combo_grid_summary.csv")
    if not _ok(g, "target", "n_cv", "n_nlp", "test_primary"):
        return "The cross-modal combination grid was not run."
    parts = []
    for kd in ("dir", "vol", "dd"):
        x = g[g["target"] == kd]
        if not len(x):
            continue
        cv_only = x[x["n_nlp"] == 0]["test_primary"].max(); with_nlp = x[x["n_nlp"] > 0]["test_primary"].max()
        parts.append(f"{TNAME[kd]}: best CV-only cell {cv_only:.3f}, best cell with NLP {with_nlp:.3f}")
    c = vcounts(H9C)
    verdict = ""
    if c:
        verdict = (f"Adding a combination of language models to a combination of vision networks helps in {c[0]} of {c[3]} tasks and is not worth it elsewhere; "
                   if c[0] > 0 else "Adding a combination of language models to a combination of vision networks does not improve the locked-test results; ")
    return (f"<b>Combinations of combinations (post-hoc).</b> For each task, the best combination of 1, 2 or 3 vision networks and of 0, 1, 2 or 3 language models (daily panel) was found on validation "
            f"and fused with a validation-chosen weight, then re-calibrated on 2021 exactly like the confirmatory late fusion. Mean locked-test primary metric over the four horizons, " + "; ".join(parts) + ". "
            f"The cell chosen on validation, against the best CV combination alone, is {vphrase(H9C)} (direction: {vphrase(H9C, 'dir')}; volatility: {vphrase(H9C, 'vol')}; "
            f"drawdown: {vphrase(H9C, 'dd')}); against the strongest numbers-only baseline it is {vphrase(H9D)}. " + verdict +
            "the simple numbers remain the benchmark to beat for volatility and drawdown.")
def text_features_text():
    cr = rtab("text_features_corr.csv")
    s = "<b>Interpretable text features (post-hoc).</b> "
    if _ok(cr, "feature", "target", "period", "rho"):
        def _r(f_, t_, p_):
            r = cr[(cr["feature"] == f_) & (cr["target"] == t_) & (cr["period"] == p_)]
            return f"{float(r['rho'].iloc[0]):+.3f} [{float(r['lo'].iloc[0]):+.3f}, {float(r['hi'].iloc[0]):+.3f}]" if len(r) else "n/a"
        s += (f"Text change (Lazy Prices; Cohen et al. 2020): Spearman correlation with the size of the reaction {_r('text change (10-K / 10-Q)', 'size of reaction |z|', 'development')} on development "
              f"filings and {_r('text change (10-K / 10-Q)', 'size of reaction |z|', 'test')} on the test. ")
        def _hi(f_, t_, p_):
            r = cr[(cr["feature"] == f_) & (cr["target"] == t_) & (cr["period"] == p_)]
            return (float(r["lo"].iloc[0]), float(r["hi"].iloc[0])) if len(r) else (np.nan, np.nan)
        _cd, _ct = _hi("text change (10-K / 10-Q)", "size of reaction |z|", "development"), _hi("text change (10-K / 10-Q)", "size of reaction |z|", "test")
        if _cd[1] < 0 and _ct[1] < 0:
            s += ("In both periods, reports whose wording changed more drew a smaller immediate reaction, not a larger one. This is consistent with the inattention that Cohen et al. describe: "
                  "the market does not price the change when the report is filed, and the return effect they document builds up over the following months. ")
        if (cr["feature"] == "LM polarity").any():
            s += (f"Loughran-McDonald polarity versus the signed abnormal return: {_r('LM polarity', 'signed abnormal return', 'test')} on the test "
                  f"(FinBERT tone for reference: {_r('FinBERT tone (reference)', 'signed abnormal return', 'test')}). ")
            _ih = H11[H11["A"] == "metadata + interpretable text features"] if _ok(H11, "A", "delta") else None
            if (cr["feature"] == "LM negative-word share").any() and _ih is not None and len(_ih):
                _d = float(_ih["delta"].iloc[0])
                s += (f"The share of Loughran-McDonald negative words goes with the size of the reaction ({_r('LM negative-word share', 'size of reaction |z|', 'development')} development, "
                      f"{_r('LM negative-word share', 'size of reaction |z|', 'test')} test); "
                      + (f"but once form, 8-K item, sector and timing are known the interpretable features add only {_d:+.3f} R-squared (section 5e), so most of this association is the kind of filing. "
                         if _d < 0.01 else f"beyond form, 8-K item, sector and timing the interpretable features add {_d:+.3f} R-squared (section 5e). "))
        else:
            s += "The Loughran-McDonald dictionary could not be loaded in this execution (reported as Not Run). "
    s += (f"Added to the no-text LightGBM on filing events, text change is {vphrase(H10A)}"
          + (f"; text change plus dictionary tone is {vphrase(H10B)}." if _ok(H10B, "verdict") else "."))
    return s
def h11_text():
    if not _ok(H11, "A", "r2_A", "r2_B", "delta", "verdict"):
        return "<b>Reaction size beyond the metadata (post-hoc).</b> Not run."
    B_ = H11["B"] if "B" in H11.columns else pd.Series(["metadata"] * len(H11))
    rows = [f"{r.A}: R-squared {r.r2_A:.3f} versus {r.r2_B:.3f} for {b_} (difference {r.delta:+.3f}, 95 % interval [{r.lo:+.3f}, {r.hi:+.3f}], {r.verdict})"
            for r, b_ in zip(H11.itertuples(), B_)]
    def _row(a_):
        x_ = H11[H11["A"] == a_]
        return x_.iloc[0] if len(x_) else None
    w0, wc = _row("metadata + words (TF-IDF)"), _row("metadata + company + words (TF-IDF)")
    if wc is not None and wc["verdict"] == "better":
        concl = (f"Because TF-IDF n-grams contain company names, the decisive comparison keeps the company in the metadata: the words still add {float(wc['delta']):+.3f} R-squared. "
                 "So the wording of a filing carries information about how strongly the market will react beyond what kind of filing it is, when it arrives and who filed it: "
                 "this is the clearest evidence of text content in the study, and it concerns the size of the reaction, not its direction.")
    elif wc is not None:
        concl = (f"Because TF-IDF n-grams contain company names, the decisive comparison keeps the company in the metadata: then the words add {float(wc['delta']):+.3f} R-squared "
                 f"({wc['verdict']})" + (f", against {float(w0['delta']):+.3f} without the company" if w0 is not None else "") +
                 ". Most of what the words seemed to explain is therefore which company filed, the same shortcut found in the forecasting models (section 8).")
    elif w0 is not None and w0["verdict"] == "better":
        concl = "So the wording carries information about the size of the reaction beyond the kind and timing of the filing; this comparison does not control for the company."
    else:
        concl = "So, once the kind of filing and its timing are known, the words add no reliable information about the size of the reaction."
    return ("<b>Do the words explain the size of the reaction beyond form, 8-K item, sector, timing and company? (post-hoc, H11)</b> " + "; ".join(rows) + ". " + concl)
def timing_text():
    d, t = rtab("event_study_timing_dev.csv"), rtab("event_study_timing_test.csv")
    if not (_ok(d, "form", "session_bucket", "mean") and _ok(t, "form", "session_bucket", "mean")):
        return ""
    def _top(df):
        x = df.sort_values("mean", ascending=False).iloc[0]
        return f"{x['form']} {x['session_bucket']} ({float(x['mean']):.2f})"
    return (f"<b>Filing timing.</b> The largest mean reaction by form and release time is {_top(d)} in the development blocks and {_top(t)} on the test; "
            "filings released outside trading hours reach a market that has had no chance to trade on them, so their reaction is concentrated in the next session.")
def ethics_items(kind):
    items = [("Data access", "SEC EDGAR was queried under the SEC fair-access policy: a declared user agent with contact details and at most 8 requests per second. Filings are public records; "
              "the price bars are a verified research data set used for non-commercial academic work only."),
             ("Personal data", "No personal data are collected or processed. Company names appear because they are the subject of public filings."),
             ("Model licences", "Pre-trained models are used under their published licences (for example Apache 2.0 or MIT for most vision backbones and encoders, "
              "AGPL-3.0 for Ultralytics YOLOv8, and the Meta Llama 2 Community License for the gated FinGPT base model); no model weights are redistributed."),
             ("Integrity of the evaluation", "Look-ahead bias is treated as a research-integrity issue: point-in-time timestamps, a test period after every language model's pre-training cut-off, "
              "a hashed freeze before the test, a logged vault, and every post-hoc analysis labelled as such."),
             ("Responsible use", "Markets are hard to predict and 'AI trading signals' are widely marketed. The reports state effect sizes with intervals, the dashboard withholds calls the test does not "
              "support, and every output carries the statement that it is educational research and not financial advice."),
             ("Compute", "The confirmatory run took about 4.2 GPU-hours (one data-centre GPU); later addenda reuse cached predictions and add CPU time only.")]
    if kind == "nlp":
        items.insert(2, ("Text use", "Filing text is processed for research and never reproduced beyond short n-grams and tokens in the reports."))
    return [Pp(f"<b>{h}.</b> {b}") for h, b in items]
def register_table(modules):
    r = rtab("hypothesis_register.csv")
    if not _ok(r, "id", "module"):
        return tbl(None)
    x = r[r["module"].isin(modules)] if modules else r
    return tbl(x, ["id", "module", "type", "statement", "tests", "outcome"], max_rows=40,
               caption="Hypothesis register: every hypothesis, whether it was fixed before the test (confirmatory) or added afterwards (post-hoc), and its outcome on the locked test")
def protocol_items():
    p = SUB["results"] / "v31_protocol.json"
    if not p.exists():
        return [Pp("The v3.1 protocol was not written in this execution.")]
    j = json.loads(p.read_text())
    return ([Pp(f"Registered {j.get('registered_utc')} (UTC); SHA-256 of the protocol file {str(j.get('sha256'))[:16]}. The 2024-2026 block is spent; v3.1 is tested only on new data.")] +
            [Pp(f"<b>{s['heading']}.</b> {s['text']}") for s in j.get("sections", [])])
def _sel_mm():
    d = rtab("combo_selection.csv")
    return d[d["modality"] == "CV + NLP"] if _ok(d, "modality") else None
def h11_short():
    if not _ok(H11, "A", "delta", "verdict"):
        return ""
    r = H11[H11["A"] == "metadata + company + words (TF-IDF)"]
    scope = "the kind, timing and company of a filing"
    if not len(r):
        r, scope = H11[H11["A"] == "metadata + words (TF-IDF)"], "the kind and timing of a filing (not controlling for the company)"
    if not len(r):
        return ""
    r = r.iloc[0]
    return (f"Beyond {scope}, its words change the explained share of the reaction size by {float(r['delta']):+.3f} R-squared "
            f"({r['verdict']}, post-hoc).")
def _cbs(modality):
    d = rtab("combo_by_size.csv")
    return d[d["modality"] == modality] if _ok(d, "modality") else None
def future_work(kind):
    common = ("A confirmatory v3.1 has been pre-registered (protocol in the multimodal report): a new forward test period from 2026-12, a wider universe including delisted companies, "
              "and five seeds per model. ")
    if kind == "cv":
        return Pp("<b>Future work.</b> " + common + "For vision specifically: a chart encoding that keeps the volatility level (fixed price scale in units of trailing volatility) next to the min-max chart, "
                  "no vertical-rescale augmentation for the volatility head, and returns-image encodings in the style of Jiang, Kelly and Xiu (2023).")
    return Pp("<b>Future work.</b> " + common + "For language specifically: layer-wise learning-rate decay and longer warm-up for the large encoders (Mosbach et al. 2021), QLoRA fine-tuning of FinGPT, "
              "minute-stamped news next to filings, and the text-change and dictionary features as pre-specified inputs.")

# %%
# ================================================================ Report 1: Computer Vision
cv_abs = (f"Seven vision models (Custom JKX-style CNN, ResNet-50, EfficientNet-B0, ConvNeXt-Tiny, ViT-B/16, Swin-T, YOLOv8s-cls) read weekly, "
          f"daily and hourly candlestick charts of {len(TICKERS)} US stocks and forecast 3-class direction, realised volatility and a >10 % "
          f"drawdown at 5, 10, 20 and 40 sessions. The validation-chosen best model was {CV_BEST} (mean rank over 12 tasks). " +
          hyp_line(H1, "H1 (CV skill against the prior and the shuffled null)") + " " + hyp_line(H5, "H5 (fine-tuning beats frozen)") + " " + hyp_line(H6, "H6 (sector-specific rankings)") +
          f" Post-hoc, against the strongest numbers-only baseline (HAR / momentum / trailing volatility, or LightGBM on 20 indicators, chosen on validation) the "
          f"best CV model per task is {vphrase(H1C)}; direction (raw macro-F1, which flatters the CV model because the baselines predict mostly one class): {vphrase(H1C, 'dir')}; "
          f"direction judged fairly, each model against its own shuffled null (H1d): {vphrase(H1D)}; volatility: {vphrase(H1C, 'vol')}; drawdown: {vphrase(H1C, 'dd')}.")

def cv_training_text():
    return Pp("One backbone shared by the three charts; features concatenated; a multi-task head (4 horizons x [3 direction logits, "
              "volatility, drawdown]). ImageNet-pretrained timm backbones and the Ultralytics YOLOv8s-cls backbone are fine-tuned end-to-end (AdamW, "
              "warm-up + cosine, bfloat16, batch 64 rows, up to 6 epochs, early stopping on 2021); the JKX-style CNN is trained from scratch. Augmentation "
              "respects chart semantics (no flips; only vertical rescale, oldest-bar crop, brightness, noise). Calibration on 2021 only (temperature, Platt, linear). " +
              best_epoch_text(CV_MAIN))

def cv_discussion():
    out = []
    ds = sig_tasks(H1, "dir")
    out.append(Pp(f"<b>Direction.</b> Against a null that shuffles labels within months (same class shares, no link to the future), the validation-chosen models show skill "
                  f"in {len(ds)} of 4 horizons after Holm correction ({', '.join(ds) if ds else 'none'}); the mean skill over the four horizons is {mean_of(H1, 'skill', 'dir'):+.3f} macro-F1. "
                  + ("The effect is small, which is expected for a 3-class label whose sideways band is scaled by volatility. " if ds else "No horizon reaches significance. ")
                  + f"On raw macro-F1 against the strongest numbers-only baseline the best CV model is {vphrase(H1C, 'dir')}; that comparison flatters the CV model, because the "
                  f"baselines predict mostly one class and macro-F1 punishes this. Judged fairly, each model against its own shuffled null (H1d, post-hoc), the best CV model is "
                  f"{vphrase(H1D)}; read the H1d table for the size of the difference."))
    if shuffle_control_text():
        out.append(Pp(shuffle_control_text()))
    vs, dsig = sig_tasks(H1, "vol"), sig_tasks(H1, "dd")
    out.append(Pp(f"<b>Volatility and drawdown.</b> Against the uninformed benchmarks (R-squared 0, AUC 0.5) the CV models have skill in {len(vs)} of 4 volatility and {len(dsig)} of 4 drawdown tasks. "
                  f"That comparison is weak, because trailing volatility alone predicts future volatility well. Against the strongest numbers-only baseline the best CV model is "
                  f"{vphrase(H1C, 'vol')} for volatility and {vphrase(H1C, 'dd')} for drawdown (post-hoc, Holm-corrected)."))
    da = abl_delta(rtab("cv_ablations_val_hiB.csv"), "with vs without augmentation", "vol")
    expl = ""
    if da is not None:
        expl = (f" One candidate explanation, not a tested cause: each chart's price axis is scaled to that chart's own high and low, which removes the absolute volatility level from the image, "
                f"and the vertical-rescale augmentation changes candle heights; the ablation without augmentation differs from the augmented model by {da:+.3f} R-squared on volatility (validation).")
    out.append(Pp("<b>Why images may not carry the volatility level (a design finding).</b>" + expl +
                  " Whatever the cause, the practical lesson is that a chart image normalised to its own price range should not be expected to forecast the level of risk; "
                  "the volatility and drawdown heads need the absolute scale, which simple numbers supply directly."))
    h5n = int(H5_HI["supported"].sum()) if _ok(H5_HI, "supported") else (int(H5["supported"].sum()) if _ok(H5, "supported") else 0)
    h5t = len(H5_HI) if _ok(H5_HI, "supported") else (len(H5) if _ok(H5, "supported") else 0)
    h5df = H5_HI if _ok(H5_HI, "delta", "p_holm") else H5
    n_w = int(((h5df["delta"] < 0) & (h5df["p_holm"] < CFG["alpha"])).sum()) if _ok(h5df, "delta", "p_holm") else 0
    out.append(Pp(f"<b>Fine-tuning versus frozen features.</b> Fine-tuning beats the frozen backbone in {h5n} of {h5t} (model, target) tests on the locked test block "
                  f"({'5,000' if _ok(H5_HI, 'supported') else '1,000'} bootstrap draws) and is significantly worse in {n_w}. " +
                  ("A significant loss from fine-tuning means that adapting every weight to noisy financial labels is not a safe default for that network. " if n_w else "") + best_epoch_text(CV_MAIN)))
    k_t = int((CV_RANK_TEST.index == CV_BEST).argmax()) + 1 if (CV_BEST in CV_RANK_TEST.index) else None
    out.append(Pp(f"<b>Validation versus test.</b> The validation winner {CV_BEST} ranks {k_t if k_t else 'n/a'} of {len(CV_RANK_TEST)} on the locked test; the best on the test ex post was "
                  f"{CV_RANK_TEST.index[0] if len(CV_RANK_TEST) else 'n/a'}. Validation covers the 2022 bear market and the test a strong 2024-2026 market, so rankings are partly regime-dependent; "
                  f"averaging the top-3 models (cv_top3) is the more robust choice and is what the dashboard uses."))
    return out
def cv_conclusion():
    ds = sig_tasks(H1, "dir")
    bv, bd = vcounts(H1C, "vol"), vcounts(H1C, "dd")
    interp = ""
    if bv and bd:
        if bv[0] == 0 and bd[0] == 0:
            interp = "In this design charts do not beat simple numbers on volatility or drawdown risk."
        elif bv[0] + bd[0] < (bv[3] + bd[3]) / 2:
            interp = "In this design charts beat simple numbers on volatility or drawdown risk in only a minority of tasks."
        else:
            interp = "In this design charts beat simple numbers on volatility or drawdown risk in most tasks."
    dtxt = (f"Charts carry a statistically supported direction signal in {len(ds)} of 4 horizons (mean skill {mean_of(H1, 'skill', 'dir'):+.3f} macro-F1 over a shuffled null)."
            if ds else "No horizon shows a statistically supported direction signal over the shuffled null.")
    dtxt += f" Compared fairly with the numbers-only baselines (each against its own shuffled null), the best CV model is {vphrase(H1D)} on direction."
    dtxt += f" Combining two or three vision networks, against the best single network: {vphrase(H9A)} (post-hoc)."
    return [Pp(f"Seven vision models were compared on identical, leakage-controlled rows. {dtxt} For volatility and drawdown risk, simple numbers are the benchmark to beat: the best CV model is "
               f"{vphrase(H1C, 'vol')} on volatility and {vphrase(H1C, 'dd')} on drawdown against the strongest numbers-only baseline. {interp} Multimodal results are in the third report.")]

CV_SECTIONS = lambda: [
    ("Abstract", [Pp(cv_abs)]),
    ("1. Problem, gap and contribution", [Pp("Can a vision model read a candlestick chart well enough to forecast direction, volatility and drawdown risk, which "
        "architecture does it best, do combinations help, and does the answer depend on the sector? Earlier work used one architecture, one timeframe or "
        "few stocks; we compare seven architectures on identical leakage-controlled rows with three timeframes, four horizons and three targets, with "
        "paired month-block bootstrap intervals and Holm correction, and test the validation choice once on 2024-2026."), *cv_contributions(), *common_front("cv"),
        figp("research_design.png", "Research design: time blocks with 40-session purges (top) and the order of work from data to the post-hoc addenda (bottom).")]),
    ("2. Images and preprocessing", [figp("chart_gallery.png", "Model inputs: weekly (52 candles), daily (63) and hourly (70) charts, 224 x 224, no text or axes."),
        tbl(rtab("image_dataset.csv"), caption="Image dataset: rows, size and storage"), tbl(rtab("label_balance.csv"), max_rows=12, caption="Class balance and base rates by horizon and block"),
        figp("eda_labels.png", "Class balance, drawdown base rates and volatility.")]),
